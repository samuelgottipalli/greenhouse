# Copy to .env and fill in. .env is git-ignored; never commit it.
# Read by core/settings.py. Variables already set in the environment take precedence.

# Database. A relative sqlite path is resolved against the server/ folder.
DB_CONNECTION_STRING=sqlite:///data/greenhouse.db

# Device the dashboard and automation control (devices.device_id).
DEVICE_ID=1

# IANA time zone for the watering schedule and the default display zone.
TIMEZONE=America/Los_Angeles

# MQTT broker. With deploy/mosquitto (anonymous access off) use the greenhouse-server account.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=greenhouse
# Encrypted connections: auto (on for port 8883, e.g. a cloud MQTT service), true or false.
MQTT_TLS=auto
# Only for a broker whose certificate this computer doesn't already trust: path to its CA file.
MQTT_CA_FILE=

# Address the controllers use to reach this computer, e.g. 192.168.1.20. Leave blank to detect it.
# Give this computer a fixed address (a DHCP reservation on the router) so it doesn't change.
PUBLIC_HOST=

# Port the controllers download over-the-air updates from (services/firmware_server.py).
FIRMWARE_PORT=8081

# Open-Meteo. Do not add a timezone parameter: times must come back in UTC.
LATITUDE=39.5349
LONGITUDE=-119.7527
WEATHER_API=https://api.open-meteo.com/v1/forecast?latitude={LATITUDE}&longitude={LONGITUDE}&daily=sunrise,sunset&current=temperature,relative_humidity_2m,rain,snowfall,showers,precipitation,apparent_temperature,is_day,weather_code,cloud_cover,wind_speed_10m,wind_direction_10m&forecast_days=1

# Light sensor: the dashboard shows an estimate in lux. The defaults suit a GL5528 LDR with a
# 10 kOhm resistor. Calibrate with a phone light meter: python -m scripts.calibrate_light <raw> <lux>
LDR_FIXED_OHMS=10000
LDR_R10_OHMS=15000
LDR_GAMMA=0.7

# Dashboard password (hash only). Set it with: python -m scripts.set_password
APP_PASSWORD_HASH=

# Alerts (services/alerts.py, every 2 min). Limits in degrees C; cooldown in minutes.
ALERT_TEMP_LOW_C=5
ALERT_TEMP_HIGH_C=40
ALERT_COOLDOWN_MIN=60
# Push: install the ntfy app and subscribe to a hard-to-guess topic, e.g. https://ntfy.sh/greenhouse-7f3k2q
NTFY_URL=
NTFY_TOKEN=
# Email (587 = STARTTLS, 465 = SSL). ALERT_EMAIL_TO may list several addresses separated by commas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
