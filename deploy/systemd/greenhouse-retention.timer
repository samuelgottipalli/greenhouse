[Unit]
Description=Monthly greenhouse summaries and clean-up (the 1st, and after every start)

[Timer]
# On the 1st of each month at 03:30 ...
OnCalendar=*-*-01 03:30:00
# ... at the next start if the computer was off then ...
Persistent=true
# ... and a few minutes after every start, in case an earlier run failed. The
# job only does what is missing, so extra runs are harmless.
OnBootSec=10min

[Install]
WantedBy=timers.target
