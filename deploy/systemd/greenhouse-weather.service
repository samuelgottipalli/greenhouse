[Unit]
Description=Greenhouse outdoor weather collector
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@SERVER_DIR@
ExecStart=@PYTHON@ -m services.weather_collector
Environment=PYTHONUNBUFFERED=1
Restart=always
# core/health.py pings the watchdog each pass; no ping for 2 min = hung, restart it.
WatchdogSec=120
NotifyAccess=main
RestartSec=5

[Install]
WantedBy=multi-user.target
